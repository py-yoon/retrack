NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SEOUL_OPENAPI_KEY=your-seoul-openapi-key
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-cloud-platform-maps-key-id
# 카카오 로그인은 Supabase Authentication > Providers > Kakao에 Client ID(REST API 키)/
# Client Secret을 등록해 Supabase가 처리한다. 이 앱 코드는 카카오 키를 직접 다루지 않는다.
